<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.AppCompat" parent="@style/Base.Theme" />
    <style name="Base.Theme.AppCompat.Light" parent="@style/Base.Theme.AppCompat" />
    <style name="Base.Widget.AppCompat.Toolbar" parent="@style/Base.Widget.AppCompat" />
    <style name="Widget.Design.AppBarLayout" parent="@style/Widget.Design">
        <item name="android:background">?colorPrimary</item>
        <item name="android:stateListAnimator">@animator/design_appbar_state_list_animator</item>
        <item name="android:touchscreenBlocksFocus">true</item>
        <item name="android:keyboardNavigationCluster">true</item>
    </style>
    <style name="Base.V26.Theme.AppCompat" parent="@style/Base.V26.Theme">
        <item name="colorError">?android:colorError</item>
    </style>
    <style name="Base.V26.Theme.AppCompat.Light" parent="@style/Base.V26.Theme.AppCompat">
        <item name="colorError">?android:colorError</item>
    </style>
    <style name="Base.V26.Widget.AppCompat.Toolbar" parent="@style/Base.V26.Widget.AppCompat">
        <item name="android:touchscreenBlocksFocus">true</item>
        <item name="android:keyboardNavigationCluster">true</item>
    </style>
</resources>
